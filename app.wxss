page {
  background-color: #f7f7f7;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial;
  color: #222222;
}

.container {
  padding: 24rpx;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.06);
}

.title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #666666;
}

.button-primary {
  background-color: #1AAD19;
  color: #ffffff;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  text-align: center;
}

.badge {
  background-color: #ff4d4f;
  color: #ffffff;
  font-size: 22rpx;
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
  display: inline-block;
}
